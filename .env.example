# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_ENV=sandbox
VITE_APP_BASE_URL=http://127.0.0.1:5173

# Backend
IAQ_ENV=development
IAQ_DATABASE_URL=postgresql+psycopg://iaq:iaq@localhost:5432/iaq
IAQ_REQUIRE_PERSISTENCE=false
IAQ_ACCESS_STORE=memory
IAQ_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
IAQ_AUTH_MODE=development
# First visits are unsigned-in. Production keeps guest assessment off until
# guest results can be durably linked to a Supabase account.
IAQ_GUEST_ASSESSMENT_ENABLED=true
IAQ_REQUIRE_VERIFIED_AGE=false
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
MIDTRANS_SERVER_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_LIVE_ENABLED=false
APP_BASE_URL=http://127.0.0.1:5173
ALLOWED_REDIRECT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WEBHOOK_BASE_URL=http://127.0.0.1:8000
DATA_ENCRYPTION_KEY=
EMAIL_FROM_ADDRESS=reports@example.invalid
RESEND_API_KEY=
IAQ_FULL_REPORT_PRICE_IDR=14900000
IAQ_REQUIRE_REVIEWED_ITEMS=false
IAQ_ASSESSMENT_DATA_ROOT=./data/assessment
# Local manual QA uses the same imported records/assets as Dataset Lab.
# Keep production on authored + reviewed-only until external catalog
# persistence and human approval are complete.
IAQ_ASSESSMENT_SOURCE=staged
IAQ_ALLOW_STAGED_ITEMS=true
PILOT_RAW_DATA_RETENTION_MONTHS=12

# Optional OpenAI interpretation layer. Keep this server-side only; never add
# OPENAI_API_KEY to a VITE_* variable or browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
IAQ_AI_ENABLED=true
OPENAI_REQUEST_TIMEOUT_SECONDS=25
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

# Feature gates: production must set safe, real values explicitly.
AUTH_GOOGLE_ENABLED=false
AUTH_EMAIL_OTP_ENABLED=true
PAYMENTS_ENABLED=true
MIDTRANS_SANDBOX_ONLY=true
STAFF_MFA_REQUIRED=true
GUARDIAN_CONSENT_REQUIRED=true
SCHOOL_OFFLINE_INVOICING_ENABLED=true
